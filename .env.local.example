# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# PayPal (active payment provider; sandbox/live split by PAYPAL_ENV)
PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# FAL.ai
FAL_KEY=your_fal_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PRISM
# Launch switch: 'live' swaps waitlist landing -> product entry CTA
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# Feedback email notification via Cloudflare Email Sending (optional; Supabase is source of truth)
# Free path: FEEDBACK_NOTIFY_TO must be the VERIFIED destination address in
# Cloudflare Email Routing (your personal inbox), not the routed alias.
# CF_EMAIL_API_TOKEN needs the "Email Sending: Edit" permission.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_EMAIL_API_TOKEN=your_cf_api_token_with_email_sending_edit
FEEDBACK_NOTIFY_TO=your_verified_personal_inbox@gmail.com
FEEDBACK_NOTIFY_FROM=noreply@vegamate.com
