# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# PayPal (active payment provider; sandbox/live split by PAYPAL_ENV)
PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# FAL.ai
FAL_KEY=your_fal_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta (Facebook) Pixel — ad conversion tracking.
# Leave blank to disable (no events fire). Set in Vercel for production only.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_APP_NAME=PRISM
# Launch switch: 'live' swaps waitlist landing -> product entry CTA
NEXT_PUBLIC_LAUNCH_MODE=waitlist
